{
  "name": "@absolutely-butter/sdk",
  "version": "0.1.0",
  "description": "A zero-dependency browser SDK for Absolutely Butter experiments.",
  "author": "Will Ferens",
  "license": "UNLICENSED",
  "keywords": [
    "ab testing",
    "experimentation",
    "bayesian",
    "thompson sampling",
    "browser sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/will-ferens/absolutely-butter.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://www.absolutely-butter.app/docs/quickstart",
  "bugs": {
    "url": "https://github.com/will-ferens/absolutely-butter/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "happy-dom": "^20.9.0",
    "tsup": "^8.5.1",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
